{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.REPLACEUSER/legacy2modern",
  "title": "Legacy2Modern",
  "description": "Audit legacy code and generate Java/Spring and jQuery/Vue migration roadmaps plus dependency risk",
  "version": "0.2.0",
  "websiteUrl": "https://github.com/REPLACEUSER/legacy2modern-mcp#readme",
  "repository": {
    "url": "https://github.com/REPLACEUSER/legacy2modern-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@legacy2modern/mcp-server",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://REPLACE_WORKER.workers.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token from /auth/register",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}