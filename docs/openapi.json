  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "McpInvokeIn": {
        "properties": {
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "params": {
            "type": "object",
            "title": "Params",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "tool"
        ],
        "title": "McpInvokeIn"
      },
      "RefactorIn": {
        "properties": {
          "source_code": {
            "type": "string",
            "title": "Source Code"
          },
          "from_stack": {
            "type": "string",
            "title": "From Stack",
            "default": "java8"
          },
          "to_stack": {
            "type": "string",
            "title": "To Stack",
            "default": "springboot3"
          }
        },
        "type": "object",
        "required": [
          "source_code"
        ],
        "title": "RefactorIn"
      },
      "RegisterIn": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "RegisterIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
