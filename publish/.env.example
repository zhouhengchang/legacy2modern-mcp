# Legacy2Modern 全平台上架凭据模板
# 用法：复制为 publish/.env，填入下面各项的值，然后执行：
#   bash publish/go_all.sh all
# 脚本会自动加载 publish/.env，无需手动 export。
#
# ⚠️ 安全提示：.env 含敏感凭据，已加入 .gitignore，切勿提交或粘贴到聊天/文档。

# ---- 1. Cloudflare Workers（正式部署 + 持久化 KV）----
# 获取：https://dash.cloudflare.com/profile/api-tokens → 创建 Token
# 权限：Workers Scripts:Edit + Workers KV Storage:Edit（Account 资源）
CLOUDFLARE_API_TOKEN=

# ---- 2. npm Registry（MCP Server 安装包）----
# 获取：https://www.npmjs.com/settings/<你的用户名>/tokens → New Token（Automation）
NPM_TOKEN=

# ---- 3. GitHub（源码仓库 + Release + tag 自动发布）----
# 获取：https://github.com/settings/tokens → Generate new token (classic) → 勾选 repo
GH_TOKEN=
GITHUB_OWNER=          # 你的 GitHub 用户名，如 zhangsan

# ---- 4. MCP 官方 Registry ----
# 无需 token：脚本内用 GitHub OIDC 登录（会要求你在浏览器授权一次）

# ---- 5. VS Code Marketplace（IDE 插件）----
# 获取：https://dev.azure.com → 右上角 User settings → Personal access tokens
# 权限：Marketplace > Manage + Publish（有效期建议 1 年）
VSCE_PAT=

# ---- 6. Docker Hub（后端镜像）----
# 获取：https://hub.docker.com/settings/security → New Access Token（Read/Write/Delete）
DOCKER_USER=
DOCKER_TOKEN=
DOCKER_REPO=           # 格式：用户名/仓库名，如 zhangsan/legacy2modern

# ---- 7. PyPI（Python SDK）----
# 获取：https://pypi.org/manage/account/token/ → Add API token
PYPI_TOKEN=
